{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awkn.cn/schemas/governance-decision/1.0.0",
  "title": "AWKN Governance Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "decision_id",
    "assessment_id",
    "report_hash",
    "policy_version",
    "skill",
    "decision",
    "required_actions",
    "approver",
    "write_applied",
    "receipt",
    "rollback_target",
    "generated_at"
  ],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "decision_id": {"type": "string", "pattern": "^gdec_[a-f0-9]{16}$"},
    "assessment_id": {"type": "string", "minLength": 1},
    "report_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "policy_version": {"type": "string", "minLength": 1},
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "decision": {
      "enum": ["DRAFT", "VALIDATING", "APPROVED", "SHADOW", "ACTIVE", "QUARANTINED", "RETIRED", "BLOCKED"]
    },
    "required_actions": {"type": "array", "items": {"type": "object"}},
    "approver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "independent"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "independent": {"type": "boolean"}
      }
    },
    "write_applied": {"type": "boolean"},
    "receipt": {"type": "object"},
    "rollback_target": {"type": ["string", "null"]},
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
