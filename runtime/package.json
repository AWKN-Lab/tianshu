{
  "name": "awkn-engine-runtime",
  "version": "0.1.0",
  "description": "awkn引擎持久化 Agent 工作流运行时",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "awkn-engine": "bin/awkn-engine.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs unit",
    "test:contracts": "node scripts/run-tests.mjs contracts",
    "test:verify": "node scripts/run-verify-tests.mjs",
    "test:all": "npm run test && npm run test:contracts",
    "test:coverage": "node --experimental-test-coverage --import tsx --test \"test/*.test.ts\" \"test/contracts/*.test.ts\"",
    "check:architecture": "node scripts/architecture-scan.mjs",
    "check": "npm run check:architecture && npm run typecheck && npm run test:all",
    "check:full": "npm run check && npm run build",
    "dev": "tsx src/cli.ts",
    "approval": "tsx src/approval-cli.ts",
    "evolution": "tsx src/evolution-cli.ts",
    "memory": "tsx src/memory-cli.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "cron-parser": "^5.5.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
