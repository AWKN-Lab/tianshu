{
  "name": "awkn-engine-runtime",
  "version": "0.1.0",
  "description": "awkn引擎 自带轻量 Node.js 运行时 — Loop Engineering L1-L4",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "awkn-engine": "bin/awkn-engine.js",
    "awkn-mcp-server": "bin/awkn-mcp-server.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
