diff --git a/runtime/src/llm/bridge-path.ts b/runtime/src/llm/bridge-path.ts
new file mode 100644
index 0000000..e5b011a
--- /dev/null
+++ b/runtime/src/llm/bridge-path.ts
@@ -0,0 +1,17 @@
+import { dirname, isAbsolute, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const RUNTIME_ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '..', '..');
+
+/**
+ * Resolve the multi-process LLM bridge directory without depending on process.cwd().
+ * An explicit override must be absolute so the IDE hook, CLI and daemon share one path.
+ */
+export function resolveLlmBridgeDir(value = process.env.AWKN_LLM_BRIDGE_DIR): string {
+  const configured = value?.trim();
+  if (!configured) return resolve(RUNTIME_ROOT, 'data', 'llm-bridge');
+  if (!isAbsolute(configured)) {
+    throw new Error('AWKN_LLM_BRIDGE_DIR must be an absolute path');
+  }
+  return resolve(configured);
+}
