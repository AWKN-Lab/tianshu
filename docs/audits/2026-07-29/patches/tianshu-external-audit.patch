@@ -0,0 +1,28 @@
+import { describe, it } from 'node:test';
+import assert from 'node:assert/strict';
+import { isAbsolute } from 'node:path';
+import { resolveLlmBridgeDir } from '../../src/llm/bridge-path.js';
+
+describe('LLM bridge shared path', () => {
+  it('resolves the default bridge directory to an absolute module-relative path', () => {
+    const originalCwd = process.cwd();
+    const before = resolveLlmBridgeDir(undefined);
+    process.chdir(process.platform === 'win32' ? originalCwd.split(/[\\/]/)[0] + '\\' : '/');
+    try {
+      const after = resolveLlmBridgeDir(undefined);
+      assert.equal(after, before);
+      assert.equal(isAbsolute(after), true);
+    } finally {
+      process.chdir(originalCwd);
+    }
+  });
+
+  it('accepts an explicit absolute bridge directory', () => {
+    const absolute = process.platform === 'win32' ? 'C:\\awkn\\llm-bridge' : '/tmp/awkn/llm-bridge';
+    assert.equal(resolveLlmBridgeDir(absolute), absolute);
+  });
+
+  it('rejects a relative override to prevent IDE/CLI/daemon path divergence', () => {
+    assert.throws(() => resolveLlmBridgeDir('runtime/data/llm-bridge'), /must be an absolute path/);
+  });
+});
