{
  "name": "revenue-daily-report",
  "description": "生成每日营收报告",
  "schedule": "0 23 * * *",
  "enabled": true,
  "command": "node",
  "args": ["scripts/revenue/revenue-tracker.js", "daily"],
  "workingDir": ".",
  "timeout": 30000,
  "retry": 3,
  "notify": {
    "onSuccess": false,
    "onFailure": true
  }
}
