{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tianhuo Runtime Contract Report",
  "type": "object",
  "required": [
    "entrypointsChecked",
    "p0Status",
    "flowConsistency",
    "safetyConsistency",
    "staleOrCorruptFiles",
    "blockingFindings",
    "warnings"
  ],
  "properties": {
    "entrypointsChecked": { "type": "array", "items": { "type": "string" } },
    "p0Status": {
      "type": "object",
      "required": ["expected", "missing", "present"],
      "properties": {
        "expected": { "type": "array", "items": { "type": "string" } },
        "missing": { "type": "array", "items": { "type": "string" } },
        "present": { "type": "array", "items": { "type": "string" } }
      }
    },
    "flowConsistency": {
      "type": "object",
      "required": ["expected", "matches", "mismatches"],
      "properties": {
        "expected": { "type": "array", "items": { "type": "string" } },
        "matches": { "type": "array", "items": { "type": "string" } },
        "mismatches": { "type": "array", "items": { "type": "string" } }
      }
    },
    "safetyConsistency": {
      "type": "object",
      "required": ["matches", "mismatches"],
      "properties": {
        "matches": { "type": "array", "items": { "type": "string" } },
        "mismatches": { "type": "array", "items": { "type": "string" } }
      }
    },
    "staleOrCorruptFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "reason", "recommendedAction"],
        "properties": {
          "path": { "type": "string" },
          "reason": { "type": "string" },
          "recommendedAction": { "type": "string" }
        }
      }
    },
    "blockingFindings": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
